# 复制本文件为 .env 后填写。.env 不会被提交（见 .gitignore）。

# ===== 服务 =====
SECRET_KEY=change-me

# ===== 数据库 =====
# 留空则使用 backend/study_assistant.db（SQLite）
DATABASE_URI=

# ===== 上传 =====
# 留空则使用 backend/uploads
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=52428800

# ===== 大模型（单独配置，OpenAI 兼容 /chat/completions） =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
